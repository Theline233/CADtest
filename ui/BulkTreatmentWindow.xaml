<Window x:Class="CadReviewUI.BulkTreatmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量替换表面处理" Width="486" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" Background="#F5F5F7" Foreground="#1D1D1F"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary Source="/CadReviewUI;component/Theme.xaml"/>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="批量替换表面处理" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="DrawingText" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Foreground="{StaticResource Text2}"/>
            <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Margin="0,3,0,16" Foreground="{StaticResource Text2}"/>

            <Label Content="原值（按当前显示值精确匹配）" Target="{Binding ElementName=CurrentBox}" Padding="0,0,0,5"/>
            <TextBox x:Name="CurrentBox" AutomationProperties.Name="原值"/>
            <Label Content="新值" Target="{Binding ElementName=ReplacementBox}" Margin="0,12,0,0" Padding="0,0,0,5"/>
            <TextBox x:Name="ReplacementBox" AutomationProperties.Name="新值"/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="12,10">
                <StackPanel>
                    <TextBlock x:Name="MatchText" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Text2}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource Ghost}" Content="取消" IsCancel="True"
                        Padding="18,7" Margin="0,0,8,0"/>
                <Button x:Name="ReplaceButton" Style="{StaticResource Primary}" Content="确认替换"
                        Padding="18,7" Click="Replace_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
