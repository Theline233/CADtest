<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CadReviewUI</RootNamespace>
    <AssemblyName>CadReviewUI</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <PackageReference Include="ClosedXML" Version="[0.105.1]" />
    <Content Include="templates\ExactQuotationTemplate-native-korean-header.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
