<Window x:Class="CadReviewUI.ConfirmBlankTreatmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表面处理留空确认" Width="540" Height="430" MinWidth="400" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F2F5F7"
        Loaded="Window_Loaded">
    <Grid Margin="18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Foreground="#244256" TextWrapping="Wrap"/>
            <TextBlock Text="以下明细仍会导出，Excel 的表面处理栏留空。复核记录保留原状态，不会标记为无需处理。"
                       Margin="0,6,0,0" Foreground="#405866" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox x:Name="AffectedRows" Grid.Row="1" Background="White" BorderBrush="#DCE5E9"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                 AutomationProperties.Name="表面处理缺值或待确认的明细">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,6" Foreground="#243D4D"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ReturnButton" Content="返回核对" IsCancel="True" Margin="0,0,8,0" MinHeight="40"/>
            <Button x:Name="ContinueButton" Grid.Column="1" Content="留空继续导出" Click="Continue_Click" MinHeight="40"
                    Background="#147A60" BorderBrush="#147A60" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
