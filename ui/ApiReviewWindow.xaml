<Window x:Class="CadReviewUI.ApiReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片 API 复查" Width="1040" Height="850" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F3F5F7" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B8C4CE"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F7A5A"/>
            <Setter Property="BorderBrush" Value="#1F7A5A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#556270"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ReadBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#D5DCE2"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="图片 API 复查" FontSize="23" FontWeight="SemiBold" Foreground="#304B63"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                       Text="建议仅供人工核对，不会修改原值或确认值。请手动选择截图，程序不会自动发送图纸。"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ReviewBody">
                <Border Background="White" BorderBrush="#D8E0E5" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="启用的配置" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,6,0,4">
                            <Button DockPanel.Dock="Right" Click="Settings_Click" Margin="8,0,0,0">API 设置 / 切换服务…</Button>
                            <ComboBox x:Name="ActiveProfileInput" DisplayMemberPath="DisplayName" Padding="5,4"/>
                        </DockPanel>
                        <TextBlock x:Name="TargetText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="选中的截图将发送到上述服务地址，接口可能产生费用；请按服务商的数据处理规则决定是否发送。"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="将发送图片原文件，包含可能不可见的 EXIF、文字或其他元数据；请在选择前自行检查。"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D8E0E5" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="当前本地记录（仅本地显示）" FontWeight="SemiBold"/>
                        <TextBox x:Name="LocalContextBox" Style="{StaticResource ReadBox}" MinHeight="50" MaxHeight="110" Margin="0,6,0,4"
                                 Text="未提供本地记录，可独立复查截图。"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="请自行选择与该记录对应的截图；系统不会自动认定两者的关联。本地记录内容不会发送给 API，也不会写入复查记录。"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D8E0E5" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="手动选择一张图框截图" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Click="ChooseImage_Click">选择 PNG / JPG / WebP…</Button>
                        </WrapPanel>
                        <TextBlock x:Name="ImagePathText" Style="{StaticResource Hint}" Text="尚未选择截图。"/>
                        <Border Background="#F3F5F7" BorderBrush="#E1E7EB" BorderThickness="1" Margin="0,8,0,0" Height="160">
                            <Grid>
                                <Image x:Name="ImagePreview" Stretch="Uniform"/>
                                <TextBlock x:Name="PreviewHint" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="选择截图后可在此预览"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SendTargetText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="发送目标：尚未启用配置。"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,4"
                                   Text="请核对所选截图与发送目标；点击下方按钮即发送，接口可能产生费用。"/>
                        <WrapPanel>
                            <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}" Click="Review_Click">发送截图并复查</Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D8E0E5" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="接口返回建议（尝试隐藏密钥原文及常见编码，不能识别所有变换）" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBox x:Name="SuggestionBox" Style="{StaticResource ReadBox}" Height="220" Margin="0,6,0,6"/>
                        <TextBlock x:Name="SourceText" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="UsageText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="RecordText" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="尚无复查记录。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
            <Button x:Name="CancelOperationButton" DockPanel.Dock="Right" Click="CancelOperation_Click"
                    Visibility="Collapsed" Margin="8,0,0,0">取消复查</Button>
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
