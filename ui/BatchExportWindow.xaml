<Window x:Class="CadReviewUI.BatchExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量导出" Width="560" Height="580" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13" Background="#F5F5F7" Foreground="#1D1D1F"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CadReviewUI;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 勾选行：点击整行切换勾选 -->
            <Style x:Key="CheckItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,9">
                                <DockPanel>
                                    <Border x:Name="Box" DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="6" Margin="0,0,12,0"
                                            Background="White" BorderBrush="{StaticResource LineStrong}" BorderThickness="1.2" VerticalAlignment="Center">
                                        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#0A000000"/></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="批量导出" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Text2}" TextWrapping="Wrap"
                       Text="勾选要导出的图纸，然后选择一个保存文件夹。每张图纸仍会显示“导出前确认”；还有待处理问题的图纸会提示并跳过。"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,14,0,8">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Ghost}" Tag="&#xE8B3;" Foreground="{StaticResource Accent}" Click="SelectAll_Click">全选</Button>
                <Button Style="{StaticResource Ghost}" Tag="&#xE8E6;" Foreground="{StaticResource Text2}" Click="SelectNone_Click" Margin="4,0,0,0">全不选</Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="ItemsList" SelectionMode="Multiple" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource CheckItem}" SelectionChanged="ItemsList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel ToolTip="{Binding Tip}">
                            <Border DockPanel.Dock="Left" MinWidth="24" Height="22" CornerRadius="6" Background="#14000000" Padding="5,0" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Number}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Btn}" Padding="18,6" IsCancel="True">取消</Button>
            <Button x:Name="ExportSelectedButton" Style="{StaticResource Primary}" Tag="&#xE896;" Padding="18,6" Margin="10,0,0,0"
                    IsEnabled="False" Click="ExportSelected_Click">导出所选</Button>
        </StackPanel>
    </Grid>
</Window>
