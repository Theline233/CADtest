<Window x:Class="CadReviewUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CadReviewUI"
        Title="CAD 图纸复核工具" Width="1500" Height="920" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13" Background="#F5F5F7" Foreground="#1D1D1F"
        UseLayoutRounding="True" SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CadReviewUI;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ShowWhenTag" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="InspectorValue" TargetType="TextBox" BasedOn="{StaticResource ReadBox}">
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="MaxHeight" Value="120"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#0F000000"/>
                <Setter Property="BorderThickness" Value="0.8"/>
            </Style>
            <Style x:Key="KeyText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#A1A1A6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,5,12,5"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,5,8,5"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="SlimProgress" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="Background" Value="#14000000"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 欢迎页操作行：Tag=图标，Content=标题，HelpText=说明 -->
            <Style x:Key="ActionRow" TargetType="Button" BasedOn="{StaticResource Ghost}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                                <Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
                                <Border x:Name="Shade" Background="#000000" Opacity="0" CornerRadius="10"/>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoft}">
                                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <ContentPresenter TextElement.FontSize="14" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontSize="12" Foreground="{StaticResource Text2}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0.045" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.08"/>
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.08"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 筛选胶囊：选中为蓝底白字 -->
            <Style x:Key="ChipItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Bd" Background="#0D000000" CornerRadius="14"/>
                                <Border x:Name="Sel" Background="{StaticResource Accent}" CornerRadius="14" Opacity="0"/>
                                <Border Padding="11,4,6,4"><ContentPresenter/></Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#17000000"/></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoScrollList" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 表格内的状态胶囊：圆点 + 文字，下拉箭头只在悬停或选中行时出现 -->
            <Style x:Key="ModePill" TargetType="ComboBox" BasedOn="{StaticResource ModeCombo}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border IsHitTestVisible="False" Background="{TemplateBinding Background}" CornerRadius="11" Padding="9,0,9,0"
                                        HorizontalAlignment="Left" Height="22">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{TemplateBinding Foreground}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8" Margin="6,1,0,0"
                                                   VerticalAlignment="Center" Opacity="0"/>
                                    </StackPanel>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Margin="10,4,10,16" Background="#F8FFFFFF" BorderBrush="#1A000000" BorderThickness="0.8"
                                            CornerRadius="10" Padding="5" Effect="{StaticResource PopupShadow}" MinWidth="120"
                                            TextElement.Foreground="{StaticResource Text}" TextElement.FontWeight="Normal">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter TargetName="Arrow" Property="Opacity" Value="0.8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter TargetName="Arrow" Property="Opacity" Value="0.8"/>
                                </DataTrigger>
                                <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Arrow" Property="Opacity" Value="1"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 分段控件式筛选 -->
            <Style x:Key="SegItem" TargetType="ListBoxItem">
                <Setter Property="Visibility" Value="{Binding Visibility}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Hover" Background="#000000" Opacity="0" CornerRadius="7"/>
                                <Border x:Name="Sel" Background="White" CornerRadius="7" Opacity="0" Effect="{StaticResource SoftShadow}"/>
                                <Border Padding="12,4"><ContentPresenter x:Name="Cp"/></Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.04"/></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Cp" Property="TextElement.FontWeight" Value="SemiBold"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 详情面板“识别依据”分组中的一行；内容为空时隐藏 -->
            <Style x:Key="EvidenceRow" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="0,0.8,0,0"/>
                <Setter Property="Padding" Value="0,9"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PlainValue" TargetType="TextBox" BasedOn="{StaticResource ReadBox}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MaxHeight" Value="150"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            </Style>

            <local:PlusOneConverter x:Key="PlusOne"/>

            <DataTemplate x:Key="EditHeader">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding}"/>
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="5,1,0,0" ToolTip="可双击修改"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 最大化时让出系统边框宽度 -->
    <Border x:Name="WindowRoot" Background="{StaticResource Bg}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <!-- ═════════════ 首页（参考 Xcode 欢迎窗口） ═════════════ -->
            <Grid x:Name="Welcome" Style="{StaticResource PageFade}">
                <Border Width="940" Height="580" CornerRadius="16" Background="{StaticResource Surface}" Effect="{StaticResource WindowShadow}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,60,24,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="560"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="44,40,44,28">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="92" Height="92" CornerRadius="22" Background="{StaticResource AppIconBrush}" Effect="{StaticResource CardShadow}">
                                    <Grid>
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="40" Foreground="White" HorizontalAlignment="Center"/>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="CAD 图纸复核" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                <TextBlock Text="本机识别 · 逐行核对 · 导出报价 Excel" Foreground="{StaticResource Text2}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,40,0,0">
                                <Button x:Name="NewButton" Style="{StaticResource ActionRow}" Tag="&#xE710;" Click="NewRecognize_Click" ToolTip="Ctrl+O"
                                        AutomationProperties.HelpText="可多选；也可以直接把 DWG 拖进窗口">选择图纸并识别</Button>
                                <Button Style="{StaticResource ActionRow}" Tag="&#xE838;" Click="OpenTask_Click" Margin="0,4,0,0"
                                        AutomationProperties.HelpText="选择识别输出目录或其中的 review 目录">打开已有复核任务</Button>
                                <Button x:Name="ResumeOrderButton" Visibility="Collapsed" Style="{StaticResource ActionRow}" Tag="&#xE72A;" Margin="0,4,0,0"
                                        Click="ResumeOrder_Click" AutomationProperties.HelpText="继续核对当前已打开的标签">返回已打开的图纸</Button>
                                <Border Margin="0,12,0,0" Background="{StaticResource DangerSoft}" CornerRadius="10" Padding="12,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=WelcomeNotice}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource Danger}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="WelcomeNotice" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <DockPanel Grid.Row="2">
                                <Button DockPanel.Dock="Right" x:Name="WelcomeSettingsButton" Style="{StaticResource Ghost}" Tag="&#xE713;" Foreground="{StaticResource Text2}"
                                        Click="DropDown_Click" Padding="8,3">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource MenuCard}">
                                            <MenuItem x:Name="WelcomeRecognitionSettingsMenu" Header="识别设置…" Tag="&#xE9F5;" Click="RecognitionSettings_Click"/>
                                            <Separator/>
                                            <MenuItem x:Name="WelcomeApiSettingsMenu" Header="API 设置…" Tag="&#xE774;" Click="ApiSettings_Click"/>
                                            <MenuItem x:Name="WelcomeApiReviewMenu" Header="图片 API 复查…" Tag="&#xEB9F;" Click="ApiReview_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    设置
                                </Button>
                                <TextBlock Text="最多 20 份 · 单份 ≤ 64 MiB · 原文件不会被改动" Foreground="{StaticResource Text3}" FontSize="11.5" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>

                        <!-- 最近任务 -->
                        <Border Grid.Column="1" Background="{StaticResource Bg}" CornerRadius="0,16,16,0" BorderBrush="{StaticResource Line}" BorderThickness="0.8,0,0,0">
                            <DockPanel Margin="14,22,14,14">
                                <TextBlock DockPanel.Dock="Top" Text="最近的任务" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2}" Margin="10,0,0,10"/>
                                <Grid>
                                    <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent" Padding="0"
                                             ItemContainerStyle="{StaticResource PlainItem}"
                                             PreviewMouseLeftButtonUp="RecentList_ItemClick" KeyDown="RecentList_KeyDown"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding ToolTip}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="38" CornerRadius="6" Background="White" BorderBrush="#14000000" BorderThickness="0.8" VerticalAlignment="Center">
                                                        <TextBlock Text="DWG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="11,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" x:Name="Remove" Style="{StaticResource IconOnly}" Tag="&#xE711;" VerticalAlignment="Center" FontSize="10"
                                                            Opacity="0" Click="RecentRemove_Click" ToolTip="从最近列表移除（不会删除图纸或复核数据）"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Remove" Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="RecentEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                Visibility="{Binding Visibility, ElementName=RecentEmpty}">
                                        <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="30" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RecentEmpty" Text="还没有最近任务" Foreground="{StaticResource Text3}" HorizontalAlignment="Center"
                                                   Margin="0,8,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═════════════ 复核工作区 ═════════════ -->
            <Grid x:Name="Workspace" Visibility="Collapsed" Style="{StaticResource PageFade}" SizeChanged="Workspace_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="460"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── 侧栏 ── -->
                <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0.8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="*" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="16,0,10,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button Style="{StaticResource IconOnly}" Tag="&#xE80F;" Click="Home_Click" ToolTip="返回首页"/>
                                <Button Style="{StaticResource IconOnly}" Tag="&#xE710;" Click="NewRecognize_Click" ToolTip="导入图纸 (Ctrl+O)"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AppIconBrush}">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="CAD 图纸复核" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,4,10,8">
                                <!-- 已打开的图纸：每个复核任务一行；选中项下方显示条数与待复核数 -->
                                <DockPanel Margin="0,0,2,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Tag="&#xE896;" Padding="6,1" MinHeight="22" FontSize="11.5"
                                            Foreground="{StaticResource Accent}" Click="BatchExport_Click" ToolTip="勾选要导出的图纸，逐张确认后保存到同一个文件夹">批量导出</Button>
                                    <TextBlock Text="已打开的图纸" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </DockPanel>
                                <ListBox x:Name="OrderTabs" Style="{StaticResource NoScrollList}" SelectionChanged="OrderTabs_SelectionChanged"
                                         ItemContainerStyle="{StaticResource PlainItem}" AlternationCount="100000">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel ToolTip="{Binding ToolTip}" Margin="-2,-3">
                                                <Button DockPanel.Dock="Right" x:Name="CloseTab" Style="{StaticResource IconOnly}" Tag="&#xE711;" Click="CloseOrderTab_Click"
                                                        MinHeight="20" MinWidth="20" Padding="3" FontSize="9" Opacity="0" VerticalAlignment="Top"
                                                        ToolTip="关闭（不删除图纸或复核数据）"/>
                                                <Border x:Name="NoBadge" MinWidth="24" Height="22" CornerRadius="6" Background="#14000000" Margin="0,0,9,0" VerticalAlignment="Top" Padding="5,0">
                                                    <TextBlock x:Name="NoText" Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource PlusOne}}"
                                                               FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="Summary" Text="{Binding ActiveTaskSummary, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               FontSize="11.5" Foreground="{StaticResource Text2}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="CloseTab" Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="CloseTab" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="Summary" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="NoBadge" Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="NoText" Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 仅当当前任务包含多张图纸（历史多图任务）时显示 -->
                                <StackPanel x:Name="FilesSection" Visibility="Collapsed" Margin="0,14,0,0">
                                    <DockPanel Margin="0,0,2,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="6,1" MinHeight="22" FontSize="11.5"
                                                Foreground="{StaticResource Accent}" Click="AllFiles_Click" ToolTip="显示本任务所有图纸的明细">全部</Button>
                                        <TextBlock x:Name="FilesSectionTitle" Text="本任务内的图纸" Style="{StaticResource SectionTitle}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ListBox x:Name="FileList" Style="{StaticResource NoScrollList}" SelectionChanged="FileList_SelectionChanged"
                                             ItemContainerStyle="{StaticResource PlainItem}" AlternationCount="100000">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="-2,-2">
                                                    <Grid.ToolTip>
                                                        <TextBlock>
                                                            <Run Text="{Binding Id, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Path, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Grid.ToolTip>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource PlusOne}}"
                                                               FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}" MinWidth="18" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                                    <Ellipse Grid.Column="1" Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#FF9500"/>
                                                                <Setter Property="ToolTip" Value="{Binding State}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="已核查"><Setter Property="Fill" Value="#34C759"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="无需确认"><Setter Property="Fill" Value="#34C759"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="不纳入本次"><Setter Property="Fill" Value="#C7C7CC"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource Text2}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource Danger}" FontSize="13"
                                                               Margin="6,2,0,0" VerticalAlignment="Top" Visibility="{Binding ErrorVisibility}" ToolTip="{Binding ErrorText}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 当前图纸：打开原图 + 简短提示 + 更多选项 -->
                        <Border Grid.Row="2" x:Name="FileEditor" BorderBrush="{StaticResource Line}" BorderThickness="0,0.8,0,0" MaxHeight="420">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12,12,12,4">
                                    <TextBlock x:Name="FileHint" Text="选择一张图纸后，可用 AutoCAD 打开原图核对。" Foreground="{StaticResource Text2}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="FileFields" Visibility="Collapsed">
                                        <Button Style="{StaticResource Btn}" Tag="&#xE8A7;" HorizontalAlignment="Stretch"
                                                Click="OpenDrawing_Click" ToolTip="用系统关联程序（如 AutoCAD）打开这张原图">用 AutoCAD 打开原图</Button>
                                        <TextBlock x:Name="FileGuidanceText" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap" Margin="2,8,0,0"
                                                   Text="打开原图核对明细，导出时确认即可。"/>
                                        <Expander x:Name="AdvancedFileOptions" Header="更多图纸选项" Style="{StaticResource SectionExpander}" Margin="-4,6,0,0">
                                            <StackPanel Margin="4,4,0,0">
                                                <TextBlock Text="诊断摘要 · 请对照原图" Style="{StaticResource Label}" Foreground="{StaticResource Warning}" FontWeight="SemiBold"/>
                                                <TextBox Style="{StaticResource ReadBox}" Height="64" Padding="8,6" Text="{Binding SelectedItem.Diagnostics, ElementName=FileList, Mode=OneWay}"/>
                                                <TextBlock Text="文件核查状态" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                                <ComboBox x:Name="FileStateBox" SelectedItem="{Binding SelectedItem.State, ElementName=FileList, Mode=TwoWay}"/>
                                                <TextBlock Text="核查说明（整份排除必须说明原因）" Style="{StaticResource Label}" Margin="0,10,0,4" TextWrapping="Wrap"/>
                                                <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                         Text="{Binding SelectedItem.Note, ElementName=FileList, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="父图与子件同时纳入时的计价范围说明" Style="{StaticResource Label}" Margin="0,10,0,4" TextWrapping="Wrap"/>
                                                <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                         Text="{Binding SelectedItem.ParentChildNote, ElementName=FileList, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <DockPanel Grid.Row="3" Margin="8,0,8,8">
                            <Button x:Name="SettingsButton" Style="{StaticResource Ghost}" Tag="&#xE713;" Foreground="{StaticResource Text2}" Click="DropDown_Click"
                                    Padding="8,3" HorizontalAlignment="Left">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource MenuCard}">
                                        <MenuItem x:Name="RecognitionSettingsMenu" Header="识别设置…" Tag="&#xE9F5;" Click="RecognitionSettings_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="ApiSettingsMenu" Header="API 设置…" Tag="&#xE774;" Click="ApiSettings_Click"/>
                                        <MenuItem x:Name="ApiReviewMenu" Header="图片 API 复查…" Tag="&#xEB9F;" Click="ApiReview_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                设置
                            </Button>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 左侧栏与内容区之间的拖动条 -->
                <Thumb Grid.Column="0" Style="{StaticResource PaneSplitter}" HorizontalAlignment="Right" Margin="0,0,-5,0"
                       DragDelta="SidebarSplitter_DragDelta" DragCompleted="Splitter_DragCompleted" MouseDoubleClick="SidebarSplitter_Reset"/>

                <!-- ── 内容区 ── -->
                <Grid Grid.Column="2" x:Name="ContentArea" SizeChanged="Content_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="68"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题区（与标题栏合一，可拖动窗口）：图纸名 + 一行摘要 + 进度；右侧操作 -->
                    <Grid x:Name="WorkspaceHeader" SizeChanged="Content_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="22,0,16,0"/>
                                <Style.Triggers>
                                    <!-- 详情面板收起时，给右上角窗口按钮让位 -->
                                    <DataTrigger Binding="{Binding Visibility, ElementName=InspectorPanel}" Value="Collapsed">
                                        <Setter Property="Margin" Value="22,0,150,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBox x:Name="ReviewerBox" Width="92" VerticalAlignment="Center" Tag="复核人" Margin="0,0,6,0" Padding="8,3" ToolTip="复核人（导出时记录）"/>
                            <Button Style="{StaticResource IconOnly}" Tag="&#xE74E;" Click="Save_Click" ToolTip="保存（Ctrl+S；改动每 15 秒自动保存）" Margin="0,0,2,0"/>
                            <Button x:Name="ValidateButton" Style="{StaticResource Ghost}" Tag="&#xE9D5;" Click="Validate_Click" Foreground="{StaticResource Text2}"
                                    ToolTip="检查是否还有未处理的问题（不导出）">校验</Button>
                            <Button x:Name="MoreButton" Style="{StaticResource IconOnly}" Tag="&#xE712;" Margin="0,0,10,0" Click="DropDown_Click" ToolTip="更多操作">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource MenuCard}">
                                        <MenuItem Header="批量导出（勾选图纸）…" Tag="&#xE896;" Click="BatchExport_Click"/>
                                        <MenuItem Header="导入 Excel 复核表…" Tag="&#xE8E5;" Click="ImportExcel_Click"/>
                                        <MenuItem Header="用 AutoCAD 打开原图" Tag="&#xE8A7;" Click="OpenDrawing_Click"/>
                                        <Separator/>
                                        <MenuItem Header="显示或隐藏详情" Tag="&#xE8A0;" Click="InspectorToggle_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="ExportButton" Style="{StaticResource Primary}" Tag="&#xE896;" Padding="14,5" Click="Export_Click"
                                    ToolTip="确认本次范围后选择保存位置">确认并导出 Excel</Button>
                        </StackPanel>
                        <StackPanel x:Name="HeaderSummary" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="StatsText" Foreground="{StaticResource Text2}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Border Width="0.8" Height="11" Background="{StaticResource LineStrong}" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProgressText" Text="已处理" Foreground="{StaticResource Text2}" FontSize="12" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="ReviewProgress" Style="{StaticResource SlimProgress}" Width="96" Height="5" Margin="10,0,8,0"
                                             VerticalAlignment="Center" Maximum="1" Value="0"/>
                                <TextBlock x:Name="ProgressPercent" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 下一步提示（一行，不加卡片） -->
                    <DockPanel Grid.Row="1" Margin="22,0,16,10">
                        <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="WorkflowHint" Foreground="{StaticResource Text2}" FontSize="12.5" TextWrapping="Wrap"
                                   Text="请用 AutoCAD 打开原图核对明细，导出时确认即可。"/>
                    </DockPanel>

                    <!-- 分段筛选；“图面打X / 重复图号 / 有校验问题 / 原值缺项”只在有内容时出现 -->
                    <Border Grid.Row="2" Margin="16,0,16,10" HorizontalAlignment="Left" Background="#EAEAEF" CornerRadius="9" Padding="2">
                        <ListBox x:Name="FilterBox" Style="{StaticResource NoScrollList}" SelectionChanged="Filter_Changed"
                                 ItemContainerStyle="{StaticResource SegItem}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Count}" FontSize="11.5" Foreground="{StaticResource Text2}" FontWeight="Normal"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- 表格卡片：标题栏放选中行操作与搜索 -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,0,16,0" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,0.8" Padding="10,7">
                                <Grid x:Name="TableToolbar">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel x:Name="SearchTools" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Grid Width="210" Margin="8,0,4,0">
                                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" TextChanged="Filter_Changed" Tag="搜索图号、部品名、材质"/>
                                            <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource Text3}"
                                                       HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <Button x:Name="InspectorToggle" Style="{StaticResource IconOnly}" Tag="&#xE8A0;" Click="InspectorToggle_Click"
                                                ToolTip="显示或隐藏详情"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="RowActions" Orientation="Horizontal">
                                        <TextBlock x:Name="SelectionText" Text="未选择" Foreground="{StaticResource Text2}" VerticalAlignment="Center"
                                                   Margin="4,0,8,0" MinWidth="52"/>
                                        <Button Style="{StaticResource Ghost}" Tag="&#xE73E;" Foreground="{StaticResource Success}" Click="BulkAdopt_Click"
                                                ToolTip="对照原图后，按图纸识别值采用选中行（Ctrl/Shift 多选）">采用图纸</Button>
                                        <Button Style="{StaticResource Ghost}" Tag="&#xE894;" Click="BulkExclude_Click" ToolTip="选中行不纳入本次报价">不纳入…</Button>
                                        <Button x:Name="BulkResetButton" Style="{StaticResource Ghost}" Tag="&#xE7A7;" Click="BulkReset_Click" ToolTip="清除确认值和说明，恢复为待复核">恢复待复核</Button>
                                        <Button x:Name="RowMoreButton" Style="{StaticResource Ghost}" Tag="&#xE712;" Click="DropDown_Click" ToolTip="重复图号与打X处理">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource MenuCard}">
                                                    <MenuItem Header="重复图号：按一处计" Tag="&#xE8C8;" Click="DuplicateSingle_Click"/>
                                                    <MenuItem Header="重复图号：改回累加" Tag="&#xE948;" Click="DuplicateSum_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="打X：改为纳入…" Tag="&#xE7BA;" Click="ReincludeCrossed_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            更多
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1" x:Name="ItemsGrid" Style="{StaticResource ModernGrid}" AutoGenerateColumns="False" Margin="4,0,4,4"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CellEditEnding="ItemsGrid_CellEditEnding" SelectionChanged="ItemsGrid_SelectionChanged" LoadingRow="ItemsGrid_LoadingRow"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True" FrozenColumnCount="4"
                                      CanUserSortColumns="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="不纳入"><Setter Property="Foreground" Value="#A1A1A6"/></DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Background" Value="#FFF4F3"/></DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F2F2F6"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E3EEFF"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource Danger}" FontSize="13"
                                                           HorizontalAlignment="Center" Visibility="{Binding ErrorVisibility}" ToolTip="{Binding ErrorText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="处理方式" Width="108" SortMemberPath="Mode">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource ModePill}" ItemsSource="{x:Static local:Rules.Modes}"
                                                          SelectedItem="{Binding Mode, Mode=OneWay}" SelectionChanged="ItemMode_SelectionChanged"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 行号：按当前显示顺序编号，便于逐行对照 -->
                                    <DataGridTemplateColumn Header="序号" Width="52" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="RowNo" Text="{Binding Header, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                           FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text3}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter TargetName="RowNo" Property="Foreground" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="图号" HeaderTemplate="{StaticResource EditHeader}" Binding="{Binding EditDrawing, UpdateSourceTrigger=Explicit}" Width="196" CellStyle="{StaticResource EditCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource EditCellTextBox}"/>
                                    <DataGridTemplateColumn Header="标记" Width="92" IsReadOnly="True" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2,0">
                                                    <Border Style="{StaticResource Tag}" Background="{StaticResource DangerSoft}" Visibility="{Binding CrossedOutVisibility}"
                                                            ToolTip="程序识别到整框打X，默认不纳入；如需纳入，请先填写纳入原因。">
                                                        <TextBlock Text="打X" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="11"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Tag}" Background="{StaticResource WarningSoft}" Visibility="{Binding DuplicateVisibility}"
                                                            ToolTip="{Binding DuplicateDetails}">
                                                        <TextBlock Text="{Binding DuplicateLabel}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="部品名" HeaderTemplate="{StaticResource EditHeader}" Binding="{Binding EditName, UpdateSourceTrigger=Explicit}" Width="130" CellStyle="{StaticResource EditCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource EditCellTextBox}"/>
                                    <DataGridTextColumn Header="材质" HeaderTemplate="{StaticResource EditHeader}" Binding="{Binding EditMaterial, UpdateSourceTrigger=Explicit}" Width="90" CellStyle="{StaticResource EditCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource EditCellTextBox}"/>
                                    <DataGridTextColumn Header="表面处理" HeaderTemplate="{StaticResource EditHeader}" Binding="{Binding EditTreatment, UpdateSourceTrigger=Explicit}" Width="110" CellStyle="{StaticResource EditCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource EditCellTextBox}"/>
                                    <DataGridTextColumn Header="数量" HeaderTemplate="{StaticResource EditHeader}" Binding="{Binding EditQuantity, UpdateSourceTrigger=Explicit}" Width="72" CellStyle="{StaticResource EditCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource EditCellTextBox}"/>
                                    <DataGridTextColumn Header="单位" HeaderTemplate="{StaticResource EditHeader}" Binding="{Binding EditUnit, UpdateSourceTrigger=Explicit}" Width="64" CellStyle="{StaticResource EditCell}" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource EditCellTextBox}"/>
                                    <DataGridTextColumn Header="类别" Binding="{Binding KindText}" IsReadOnly="True" Width="64" ElementStyle="{StaticResource MutedCellText}"/>
                                    <DataGridTextColumn Header="需核对事项" Binding="{Binding Warnings}" IsReadOnly="True" Width="280" ElementStyle="{StaticResource WarnText}"/>
                                    <DataGridTextColumn Header="图纸文件" Binding="{Binding FileName}" IsReadOnly="True" Width="240" ElementStyle="{StaticResource MutedCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- 问题与日志：默认收起，有问题时自动展开 -->
                    <Expander Grid.Row="4" x:Name="IssuesPanel" Style="{StaticResource SectionExpander}" Margin="14,6,16,0">
                        <Expander.Header>
                            <TextBlock>
                                <Run Text="问题与日志"/><Run x:Name="IssueCountRun" Text="" Foreground="#D70015"/>
                            </TextBlock>
                        </Expander.Header>
                        <Border Style="{StaticResource Card}" Height="150" Margin="2,2,0,0">
                            <TabControl x:Name="BottomTabs" Style="{StaticResource UnderlineTabs}">
                                <TabItem Header="待处理问题" x:Name="ErrorTab">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="双击问题可定位到对应明细或图纸" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="14,2,0,2"/>
                                        <ListBox x:Name="ErrorList" MouseDoubleClick="ErrorList_DoubleClick" BorderThickness="0" Background="Transparent"
                                                 Padding="6,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource PlainItem}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="-4,-4">
                                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource Danger}" FontSize="12"
                                                                   VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="运行日志">
                                    <TextBox x:Name="LogBox" Style="{StaticResource ReadBox}" BorderThickness="0" Background="Transparent"
                                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" Padding="12,6"/>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Expander>

                    <!-- 状态行 -->
                    <DockPanel Grid.Row="5" Margin="22,2,16,8">
                        <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                                     Foreground="{StaticResource Accent}" Background="#14000000" BorderThickness="0" Margin="12,0,0,0"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource Text3}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>

                <!-- ── 详情（检查器） ── -->
                <!-- 内容区与详情栏之间的拖动条（详情收起时隐藏） -->
                <Thumb Grid.Column="3" Style="{StaticResource PaneSplitter}" HorizontalAlignment="Left" Margin="-5,0,0,0"
                       Visibility="{Binding Visibility, ElementName=InspectorPanel}"
                       DragDelta="InspectorSplitter_DragDelta" DragCompleted="Splitter_DragCompleted" MouseDoubleClick="InspectorSplitter_Reset"/>
                <Border Grid.Column="3" x:Name="InspectorPanel" Width="330" Background="#F7F7F9" BorderBrush="{StaticResource Line}" BorderThickness="0.8,0,0,0"
                        ClipToBounds="True">
                    <Grid x:Name="InspectorContent" DataContext="{Binding SelectedItem, ElementName=ItemsGrid}" Width="330" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="68"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="20,0,146,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconOnly}" Tag="&#xE711;" Click="InspectorToggle_Click" ToolTip="隐藏详情"
                                    VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" FontSize="11"/>
                            <TextBlock Text="详情" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=ItemsGrid}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="28" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
                            <TextBlock Text="未选择明细" FontWeight="SemiBold" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="在表格中选择一行查看详情" Foreground="{StaticResource Text3}" FontSize="12"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=ItemsGrid}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="20,0,18,18">
                                <!-- 标题：图号、所属图纸、处理方式与标记 -->
                                <TextBlock Text="{Binding EditDrawing}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Text3}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <WrapPanel Margin="0,12,0,18">
                                    <ComboBox Style="{StaticResource ModeCombo}" ItemsSource="{x:Static local:Rules.Modes}" Width="108" Margin="0,0,6,4"
                                              SelectedItem="{Binding Mode, Mode=OneWay}" SelectionChanged="ItemMode_SelectionChanged"/>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource DangerSoft}" Visibility="{Binding CrossedOutVisibility}" Padding="8,2" Margin="0,0,4,4">
                                        <TextBlock Text="图面打X" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="12"/>
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource WarningSoft}" Visibility="{Binding DuplicateVisibility}" Padding="8,2" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding DuplicateLabel}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" FontSize="12"/>
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource NeutralSoft}" Padding="8,2" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding KindText}" Foreground="{StaticResource Text2}" FontSize="12"/>
                                    </Border>
                                </WrapPanel>

                                <!-- 校验问题 -->
                                <Border Background="{StaticResource DangerSoft}" CornerRadius="10" Padding="12,9" Margin="0,0,0,12" Visibility="{Binding ErrorVisibility}">
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource Danger}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>

                                <!-- 需核对事项 -->
                                <Border Background="{StaticResource WarningSoft}" CornerRadius="10" Padding="12,9" Margin="0,0,0,18" Tag="{Binding Warnings}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="Tag" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource Warning}" FontSize="13" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                        <TextBox Text="{Binding Warnings, Mode=OneWay}" Style="{StaticResource PlainValue}" Foreground="{StaticResource Warning}" Margin="0"/>
                                    </DockPanel>
                                </Border>

                                <!-- 字段对照 -->
                                <TextBlock Text="字段对照" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}" Padding="14,4" Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="当前" Style="{StaticResource KeyText}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="识别原值" Style="{StaticResource KeyText}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="图号" Style="{StaticResource KeyText}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditDrawing}" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OrigDrawing}" Style="{StaticResource ValueText}" Foreground="{StaticResource Text2}"/>
                                        <TextBlock Grid.Row="2" Text="名称" Style="{StaticResource KeyText}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EditName}" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OrigName}" Style="{StaticResource ValueText}" Foreground="{StaticResource Text2}"/>
                                        <TextBlock Grid.Row="3" Text="材质" Style="{StaticResource KeyText}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EditMaterial}" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding OrigMaterial}" Style="{StaticResource ValueText}" Foreground="{StaticResource Text2}"/>
                                        <TextBlock Grid.Row="4" Text="工艺" Style="{StaticResource KeyText}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EditTreatment}" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding OrigTreatment}" Style="{StaticResource ValueText}" Foreground="{StaticResource Text2}"/>
                                        <TextBlock Grid.Row="5" Text="数量" Style="{StaticResource KeyText}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueText}">
                                            <Run Text="{Binding EditQuantity, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding EditUnit, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource ValueText}" Foreground="{StaticResource Text2}">
                                            <Run Text="{Binding OrigQuantity, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding OrigUnit, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- 识别依据：一个分组，空项自动隐藏 -->
                                <TextBlock Text="识别依据" Style="{StaticResource SectionTitle}"/>
                                <Border Style="{StaticResource Card}" Padding="14,0" Margin="0,0,0,18">
                                    <StackPanel Margin="0,-0.8,0,0">
                                        <Border Style="{StaticResource EvidenceRow}" Tag="{Binding MissingText}">
                                            <StackPanel>
                                                <TextBlock Text="原值缺项" Style="{StaticResource RowLabel}"/>
                                                <TextBox Style="{StaticResource PlainValue}" Text="{Binding MissingText, Mode=OneWay}" Foreground="{StaticResource Danger}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource EvidenceRow}" Tag="{Binding QuantityEvidence}">
                                            <StackPanel>
                                                <TextBlock Text="数量原文" Style="{StaticResource RowLabel}"/>
                                                <TextBox Style="{StaticResource PlainValue}" Text="{Binding QuantityEvidence, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource EvidenceRow}" Tag="{Binding TreatmentEvidence}">
                                            <StackPanel>
                                                <TextBlock Text="工艺原文" Style="{StaticResource RowLabel}"/>
                                                <TextBox Style="{StaticResource PlainValue}" Text="{Binding TreatmentEvidence, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource EvidenceRow}" Tag="{Binding ParentsText}">
                                            <StackPanel>
                                                <TextBlock Text="父图号" Style="{StaticResource RowLabel}"/>
                                                <TextBox Style="{StaticResource PlainValue}" Text="{Binding ParentsText, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource EvidenceRow}" Tag="{Binding DuplicateDetails}">
                                            <StackPanel>
                                                <TextBlock Text="重复图框（打X不计入累加）" Style="{StaticResource RowLabel}"/>
                                                <TextBox Style="{StaticResource PlainValue}" Text="{Binding DuplicateDetails, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 历史说明 -->
                                <StackPanel x:Name="NoteSection" Style="{StaticResource ShowWhenTag}" Tag="{Binding Note}">
                                    <TextBlock Text="历史说明" Style="{StaticResource SectionTitle}"/>
                                    <Border Style="{StaticResource Card}" Padding="14,10">
                                        <StackPanel>
                                            <TextBox Style="{StaticResource PlainValue}" Text="{Binding Note, Mode=OneWay}" Margin="0"/>
                                            <Button Content="处理并清除旧说明" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Click="ClearOldItemNote_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═════════════ 识别进度（从工具栏下方滑入的表单） ═════════════ -->
            <Border x:Name="RunningPanel" Visibility="Collapsed" Background="#26000000">
                <Border x:Name="RunningContent" Width="640" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,56,0,0"
                        Style="{StaticResource SheetIn}" Background="#FCFFFFFF" CornerRadius="14" Padding="22,20" Effect="{StaticResource PopupShadow}"
                        BorderBrush="#14000000" BorderThickness="0.8">
                    <StackPanel>
                        <DockPanel>
                            <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AppIconBrush}" Margin="0,0,14,0">
                                <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" Foreground="White" FontSize="17" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="RunningTitle" Text="正在识别图纸…" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="已完成的图纸会立即打开，可先开始核对" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,12" Foreground="{StaticResource Accent}" Background="#14000000" BorderThickness="0"/>
                        <TextBox x:Name="RunningLog" Style="{StaticResource ReadBox}" Height="260" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" Padding="10,8"/>
                        <Button Style="{StaticResource Btn}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,5" Click="CancelRun_Click">取消识别</Button>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═════════════ 拖放提示 ═════════════ -->
            <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#D9F5F5F7" AllowDrop="True" Style="{StaticResource FadeBorder}"
                    DragLeave="DropOverlay_DragLeave">
                <Grid Margin="28" IsHitTestVisible="False">
                    <Rectangle RadiusX="22" RadiusY="22" Stroke="{StaticResource Accent}" StrokeThickness="2.5" StrokeDashArray="5 4" Fill="#0A007AFF"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="84" Height="84" CornerRadius="22" Background="{StaticResource AppIconBrush}" HorizontalAlignment="Center" Effect="{StaticResource CardShadow}">
                            <TextBlock Text="&#xE898;" Style="{StaticResource IconText}" FontSize="36" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="松开鼠标，开始识别" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock Text="仅支持 .dwg 文件，原文件不会被改动" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════════ 操作轻提示（底部居中，自动消失） ═════════════ -->
            <Border x:Name="Toast" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,44" Background="#EB2C2C2E" CornerRadius="12" Padding="16,10" MaxWidth="620" Effect="{StaticResource PopupShadow}">
                <Border.RenderTransform><TranslateTransform x:Name="ToastShift"/></Border.RenderTransform>
                <DockPanel>
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="#30D158" FontSize="13" Margin="0,1,10,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" FontSize="13"/>
                </DockPanel>
            </Border>

            <!-- ═════════════ 窗口按钮（Windows 布局，右上角） ═════════════ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Tag="&#xE921;" Click="CaptionMinimize_Click" ToolTip="最小化"/>
                <Button Style="{StaticResource CaptionMaximize}" Click="CaptionMaximize_Click"/>
                <Button Style="{StaticResource CaptionClose}" Click="CaptionClose_Click" ToolTip="关闭"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
